rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Collection danh sách món ăn Tâm Chay
    match /tam_chay_dishes/{dishId} {
      allow read, write: if true;
    }
    match /dishes/{dishId} {
      allow read, write: if true;
    }

    // Collection thông tin quán Tâm Chay
    match /tam_chay_shop_info/{docId} {
      allow read, write: if true;
    }
    match /shopInfo/{docId} {
      allow read, write: if true;
    }

    // Collection cài đặt hệ thống
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Mặc định từ chối tất cả các vị trí không xác định
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

