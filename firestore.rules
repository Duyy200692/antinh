rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu dishes collection (tam_chay_dishes & dishes)
    match /tam_chay_dishes/{dishId} {
      allow read, write: if true;
    }
    match /dishes/{dishId} {
      allow read, write: if true;
    }
    
    // Shop information collection (tam_chay_shop_info & shopInfo)
    match /tam_chay_shop_info/{docId} {
      allow read, write: if true;
    }
    match /shopInfo/{docId} {
      allow read, write: if true;
    }
  }
}
