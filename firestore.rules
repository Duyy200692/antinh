rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu dishes collection: public read, write for menu management
    match /dishes/{dishId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Shop information collection: public read, write for shop config
    match /shopInfo/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
