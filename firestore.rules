rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu dishes collection
    match /tam_chay_dishes/{dishId} {
      allow read, write: if true;
    }
    match /dishes/{dishId} {
      allow read, write: if true;
    }
    
    // Shop information collection
    match /tam_chay_shop_info/{docId} {
      allow read, write: if true;
    }
    match /shopInfo/{docId} {
      allow read, write: if true;
    }

    // Settings collection (menu_dishes_list & shop_info)
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
